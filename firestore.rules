rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director'
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enabled != false;
    }

    function isDirector() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enabled != false;
    }

    function isStaff() {
      return isDirector();
    }

    function isOrganizationAdmin(organizationId) {
      return isDirector();
    }

    function joinableOrganization(organizationId) {
      return organizationId == 'maranatha-romanian-church'
        || (
          exists(/databases/$(database)/documents/organizations/$(organizationId))
          && get(/databases/$(database)/documents/organizations/$(organizationId)).data.enabled != false
        );
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /devices/{deviceId} {
      allow get: if isAdmin()
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.isDisabled == false
        && joinableOrganization(request.resource.data.organizationId);
      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.isDisabled == resource.data.isDisabled
          && (
            request.resource.data.organizationId == resource.data.organizationId
            || resource.data.organizationId == null
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'deviceName',
            'manufacturer',
            'model',
            'platformVersion',
            'appVersion',
            'buildNumber',
            'fcmToken',
            'hasFcmToken',
            'notificationsEnabled',
            'notificationPermissionStatus',
            'minimumSupportedVersion',
            'isOutdated',
            'lastSeenAt',
            'id',
            'joinStatus',
            'organizationName',
            'displayName',
            'firstName',
            'lastName',
            'deviceNumber',
            'deviceType',
            'staffAccessRequested',
            'songDeliveryListenerActive',
            'songDeliveryListenerStatus',
            'diagnosticsUpdatedAt',
          ])
        );
      allow delete: if isAdmin();
    }

    match /organizations/{organizationId} {
      allow read: if true;
      allow create, update, delete: if isOrganizationAdmin(organizationId);

      match /members/{userId} {
        allow read: if isOrganizationAdmin(organizationId)
          || (isSignedIn() && request.auth.uid == userId);
        allow write: if isOrganizationAdmin(organizationId);
      }

      match /security/{securityId} {
        allow read, write: if isOrganizationAdmin(organizationId);
      }
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notification_logs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /mail/{mailId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow get: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Song deliveries are created, edited, and withdrawn through trusted
    // Cloud Functions so the five-minute correction window is server-enforced.
    match /song_deliveries/{deliveryId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /custom_notifications/{notificationId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
