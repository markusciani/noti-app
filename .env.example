# Backend selection
# firebase (default) | supabase | convex | postgres_api | mysql_api | mongodb_api | custom_api
NOTI_BACKEND_PROVIDER=firebase

# Generic secure backend API base URL used by postgres/mysql/mongodb/custom_api adapters
NOTI_BACKEND_API_BASE_URL=https://api.your-domain.example/noti

# Supabase integration
NOTI_SUPABASE_URL=https://your-project.supabase.co
NOTI_SUPABASE_ANON_KEY=your-public-anon-key

# Convex integration
NOTI_CONVEX_URL=https://your-team.convex.cloud

# Custom REST API integration
NOTI_CUSTOM_API_URL=https://api.your-domain.example/noti

# Push transport selection (database-agnostic)
# Keep FCM unless your backend provides a different secure transport.
NOTI_NOTIFICATION_TRANSPORT=fcm
